{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/person",
  "title": "Person",
  "description": "A person record.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The person's full name.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "age": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "x-owner": {
    "team": "identity"
  }
}
